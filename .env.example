# ==============================================================================
# UNIVERSAL REUSABLE BUSINESS MODULES ECOSYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# General Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-universal-modules-ecosystem-change-in-production

# Platform & Tenant Context
PLATFORM_MODE=standalone
# Options: standalone | multi_tenant | integrated
DEFAULT_ORGANIZATION_ID=org_default_001
DEFAULT_FACILITY_ID=fac_main_warehouse_01

# Database Configuration (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ecosystem_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Shared Universal File Storage
STORAGE_PROVIDER=local
# Options: local | minio | s3
LOCAL_STORAGE_ROOT=./uploads
MAX_UPLOAD_SIZE_BYTES=26214400

# MinIO / S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ecosystem-files
MINIO_SECURE=False
AWS_REGION=us-east-1

# CORS & Gateway
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
FRONTEND_URL=http://localhost:5173
API_GATEWAY_URL=http://localhost:8000

# Module Registry & Flags
ENABLE_INVENTORY_MODULE=True
ENABLE_PURCHASE_MODULE=False
ENABLE_SALES_MODULE=False

