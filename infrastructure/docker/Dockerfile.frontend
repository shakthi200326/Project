FROM node:20-alpine

WORKDIR /app

# Copy package manifests first for efficient docker layer caching
COPY modules/inventory/frontend/package*.json ./modules/inventory/frontend/

WORKDIR /app/modules/inventory/frontend
RUN npm install

WORKDIR /app
COPY . .

EXPOSE 5173

CMD ["npm", "--prefix", "modules/inventory/frontend", "run", "dev", "--", "--host", "0.0.0.0"]

